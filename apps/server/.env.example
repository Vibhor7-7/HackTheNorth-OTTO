# Otto server environment. Section 5.2 of MainPRD.md.
#
#   cp apps/server/.env.example apps/server/.env
#
# Fill in the three marked REQUIRED and the server boots. Everything else has a
# working default or degrades honestly when left blank. No secret belongs
# anywhere but this file (Section 0 rule 6, NF-5) - and .env is gitignored.


# ─── required: the server refuses to start without these ────────────────────

# platform.openai.com. Pays for Realtime, the task agent, extraction and chat.
# Set a spending cap on the account before the first session opens (NF-7):
# Realtime bills per audio minute and a session left streaming silence bills
# continuously.
OPENAI_API_KEY=                          # REQUIRED

# Shared secrets you invent. Any non-empty string; they only have to match what
# the device firmware and the Expo app send. The device presents its token as
# ?token= on the WS URL; the app sends "Authorization: Bearer <APP_API_KEY>".
DEVICE_TOKEN=dev-device-token            # REQUIRED (this default is fine locally)
APP_API_KEY=dev-app-key                  # REQUIRED (this default is fine locally)


# ─── server ─────────────────────────────────────────────────────────────────

PORT=3000

# The public https:// origin. Used for the SMS webhook and the Connect Link
# callback, so Composio and Twilio can reach us. Localhost works until you need
# either of those; then it must be your cloudflared or Railway URL (OD-9).
#   cloudflared tunnel --url http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000


# ─── Composio: the action layer (CMP-*) ─────────────────────────────────────
#
# Leave blank and the server still runs: /api/extensions returns a placeholder
# list and every task fails honestly at the gate. Nothing crashes, but no real
# work gets done.
#
# Setup, in order:
#   1. platform.composio.dev, copy the API key below. It needs `connected_accounts`
#      WRITE access - a read-only key cannot create a Connect Link, so S0 cannot
#      run at all. The key rate limits hard and reports throttling as
#      "401 Invalid API key", so do not chase a phantom auth bug.
#   2. Create an Auth Config for Google Calendar and WhatsApp.
#   3. Connect Google Calendar for COMPOSIO_USER_ID.
#   4. Do NOT connect WhatsApp. Its absence is demo scenario S0 (D-16) - the live
#      Connect Link is the Composio track's whole thesis. Only an ACTIVE account
#      counts as connected; an INITIALIZING one is an abandoned flow.
#
# No per-integration tokens go here (CMP-2). Composio holds every OAuth token,
# and the auth config ids are looked up at runtime by toolkit.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=demo-user

# WhatsApp direct-token testing only (`pnpm whatsapp`). Not needed by the server:
# once connected, Composio holds the token and these can be deleted (CMP-2, NF-5).
#   WABA_ID     WhatsApp Business Account ID, 15-16 digits, from WhatsApp > API Setup
#   META_TOKEN  access token from that same page (the 24h one is fine to test with),
#               or a permanent system-user token starting EAA
WABA_ID=
META_TOKEN=


# ─── models (all OpenAI, Section 11.1) ──────────────────────────────────────

REALTIME_MODEL=gpt-realtime              # the voice loop, audio to audio (VG-2)
REALTIME_VOICE=marin                     # any Realtime voice
TRANSCRIBE_MODEL=gpt-4o-transcribe       # Realtime input transcription (VG-8, D-13)
AGENT_MODEL=gpt-4.1-mini                 # task agent tool loop (AG-2, D-14)
EXTRACT_MODEL=gpt-4.1-nano               # action item extraction, cheapest clean JSON (ACT-1)
CHAT_MODEL=gpt-4.1-mini                  # Chat tab context agent (CHAT-1)


# ─── behaviour and tuning ───────────────────────────────────────────────────

# true enables the fallbacks listed in Section 8. They run through the same
# agent, gate and step log, so the app still tells the true story.
DEMO_MODE=true

# Closes an idle Realtime session (VG-13). The next button press reopens it
# (VG-9). This is the cost control; do not raise it without a reason.
REALTIME_IDLE_TIMEOUT_MS=60000

# SQLite file, created on first boot along with its directory.
DATABASE_PATH=./data/otto.sqlite


# ─── debugging ──────────────────────────────────────────────────────────────

# Logs every inbound Realtime event type. Use it when an event name looks wrong;
# they changed between beta and GA (Section 0 rule 7).
# REALTIME_DEBUG=true
