# Section 5.2. No hardcoded secrets anywhere else (Section 0 rule 6, NF-5).
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # https://... for SMS webhooks and connect-link callbacks
DEVICE_TOKEN=dev-device-token           # shared secret the ESP32 presents
APP_API_KEY=dev-app-key                 # shared secret the Expo app presents

OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-transcribe
AGENT_MODEL=gpt-4.1-mini
EXTRACT_MODEL=gpt-4.1-nano
CHAT_MODEL=gpt-4.1-mini

COMPOSIO_API_KEY=
COMPOSIO_USER_ID=demo-user

SMS_PROVIDER=                           # twilio | linq | (empty = app-only approvals, D-22)
SMS_FROM=
SMS_USER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

DEMO_MODE=true
REALTIME_IDLE_TIMEOUT_MS=60000

# local only
DATABASE_PATH=./data/otto.sqlite
