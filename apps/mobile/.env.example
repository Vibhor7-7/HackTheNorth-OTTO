# Copy to apps/mobile/.env (gitignored) to run the app against the real server.
# Use the laptop LAN address, not localhost: on a phone, localhost is the phone.
# Leave EXPO_PUBLIC_OTTO_URL unset to run the local simulation instead.
EXPO_PUBLIC_OTTO_URL=http://192.168.1.20:3000
EXPO_PUBLIC_OTTO_KEY=dev-app-key
